{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "bun-types"
    ]
  },
  "include": [
    "bin/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts"
  ]
}
