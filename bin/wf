#!/usr/bin/env sh

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
CLI_PATH="$SCRIPT_DIR/../src/cli.ts"

if command -v bun >/dev/null 2>&1; then
  exec bun "$CLI_PATH" "$@"
fi

if [ -x "${HOME:-}/.bun/bin/bun" ]; then
  exec "${HOME}/.bun/bin/bun" "$CLI_PATH" "$@"
fi

printf '%s\n' "bun is required to run wf. Install Bun or add it to PATH." >&2
exit 127
